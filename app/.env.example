# Copy to app/.env and fill in the keys
OPENAI_API_KEY=
JEV_API_KEY=jv_live_...

# Optional overrides (defaults shown)
# MODEL=gpt-6-luna
# EFFORT=medium
# EMBEDDINGS_MODEL=text-embedding-3-small
# IMAGE_MODEL=gpt-image-2.5-flare
# SLIDE_QUALITY=medium
# WHISPER_MODEL=base
# PRICES_MIN=0.5
# CONSTRAINTS_MIN=0.5
# PORT=5002

# Index the backup transcript at startup, so the chat works without uploading a call
PRELOAD_TRANSCRIPT=transcripcion_respaldo.json
PRELOAD_CLIENT=ritmofit
